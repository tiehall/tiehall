apps/web/next-env.d.ts
apps/web/test/fixtures/*/next-env.d.ts
*.tsbuildinfo
# Next.js 16's dev server writes its agent notes here; they are not Tiehall's
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Planning material kept only on the maintainer machine (D38), like a .env
private/
