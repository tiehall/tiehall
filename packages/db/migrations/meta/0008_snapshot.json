      "checkConstraints": {
        "events_number_positive": {
          "name": "events_number_positive",
          "value": "\"events\".\"number\" > 0"
        },
        "events_class_known": {
          "name": "events_class_known",
          "value": "\"events\".\"class\" IN ('domain', 'security')"
        },
        "events_data_is_object": {
          "name": "events_data_is_object",
          "value": "jsonb_typeof(\"events\".\"data\") = 'object'"
        },
        "events_actor_kind_known": {
          "name": "events_actor_kind_known",
          "value": "\"events\".\"actor_kind\" IN ('agent', 'web_session', 'system', 'integration', 'operator')"
        },
        "events_surface_known": {
          "name": "events_surface_known",
          "value": "\"events\".\"surface\" IS NULL OR \"events\".\"surface\" IN ('web', 'mcp', 'cli', 'api', 'github', 'jira')"
        },
        "events_actor_names_user": {
          "name": "events_actor_names_user",
          "value": "\"events\".\"actor_kind\" NOT IN ('agent', 'web_session') OR (\"events\".\"actor_user_id\" IS NOT NULL AND \"events\".\"surface\" IS NOT NULL)"
        },
        "events_operator_names_command": {
          "name": "events_operator_names_command",
          "value": "(\"events\".\"actor_kind\" = 'operator') = (\"events\".\"operator_command\" IS NOT NULL) AND (\"events\".\"actor_kind\" <> 'operator' OR (\"events\".\"actor_user_id\" IS NULL AND \"events\".\"client\" IS NULL AND \"events\".\"surface\" IS NULL AND \"events\".\"team_id\" IS NULL))"
        }
      },
