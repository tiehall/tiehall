{
  "name": "@tiehall/packet",
  "version": "0.0.0",
  "private": true,
  "description": "The handoff packet schema tiehall.packet/v1 with its conformance fixtures, from which @tiehall/packet is built, and the renderer, notice templates and proposal text of what agents read, which that package leaves out.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./notices": "./src/notices.ts",
    "./render": "./src/render.ts",
    "./schema/v1-beta.json": "./schema/v1-beta.json",
    "./proposals": "./src/proposals.ts",
    "./tool-text": "./src/tool-text.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "4.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
