{
  "components": {
    "schemas": {
      "Problem": {
        "description": "An RFC 9457 problem details object.",
        "properties": {
          "detail": {
            "description": "What happened, in Tiehall's own words.",
            "type": "string"
          },
          "errors": {
            "description": "For input that fails the schema: where it fails.",
            "items": {
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "retryAfter": {
            "description": "For a limit or a shutdown: the seconds to wait, as Retry-After says.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "status": {
            "description": "The HTTP status.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "title": {
            "description": "A short summary of the kind of refusal.",
            "type": "string"
          },
          "type": {
            "description": "The problem type: a URI under https://tiehall.com/problems/ that names the kind of refusal.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "An OAuth access token or a personal access token, in the Authorization header; for contract.report, a GitHub Actions OIDC token. Each operation lists the scopes its token needs.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The REST API of a Tiehall install, under /api/v1. It is beta: each operation carries its stability level, and breaking changes follow the notice rules on the changelog page at /docs/api/changelog.",
    "title": "Tiehall API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/requests": {
      "post": {
        "operationId": "requests.create",
        "parameters": [
          {
            "description": "A key of your choice that makes a retried POST run once: a repeat with the same key and body within 24 hours gets the first response, and the same key with another body gets 422 (draft-ietf-httpapi-idempotency-key-header).",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "description": "A key of your choice that makes a retried POST run once: a repeat with the same key and body within 24 hours gets the first response, and the same key with another body gets 422 (draft-ietf-httpapi-idempotency-key-header).",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "requestingTeam": {
                    "description": "The key of the team you open it from, one of yours; needed when you belong to several teams.",
                    "pattern": "^[A-Z][A-Z0-9]{1,9}$",
                    "type": "string"
                  },
                  "targetTeam": {
                    "description": "The key of the team the request is addressed to, such as FE.",
                    "pattern": "^[A-Z][A-Z0-9]{1,9}$",
                    "type": "string"
                  },
                  "title": {
                    "description": "The request's title: one line of 1 to 200 characters.",
                    "maxLength": 200,
                    "minLength": 1,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "targetTeam",
                  "title"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "claimant": {
                      "anyOf": [
                        {
                          "properties": {
                            "bot": {
                              "type": "boolean"
                            },
                            "id": {
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                              "type": "string"
                            },
                            "kind": {
                              "const": "human",
                              "type": "string"
                            },
                            "login": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "login",
                            "kind",
                            "bot"
                          ],
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "type": "string"
                    },
                    "id": {
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "requester": {
                      "properties": {
                        "team": {
                          "properties": {
                            "id": {
                              "format": "uuid",
                              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                              "type": "string"
                            },
                            "key": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "key"
                          ],
                          "type": "object"
                        },
                        "user": {
                          "anyOf": [
                            {
                              "properties": {
                                "bot": {
                                  "type": "boolean"
                                },
                                "id": {
                                  "format": "uuid",
                                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                  "type": "string"
                                },
                                "kind": {
                                  "const": "human",
                                  "type": "string"
                                },
                                "login": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "login",
                                "kind",
                                "bot"
                              ],
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "user",
                        "team"
                      ],
                      "type": "object"
                    },
                    "state": {
                      "enum": [
                        "open",
                        "claimed",
                        "in_progress",
                        "needs_info",
                        "done",
                        "declined",
                        "withdrawn"
                      ],
                      "type": "string"
                    },
                    "targetTeam": {
                      "properties": {
                        "id": {
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "key"
                      ],
                      "type": "object"
                    },
                    "untrusted": {
                      "properties": {
                        "title": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "id",
                    "key",
                    "state",
                    "targetTeam",
                    "requester",
                    "claimant",
                    "createdAt",
                    "untrusted"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The operation's result."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The input fails the operation's schema, or is outside what the install's settings allow."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call carries no valid token."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The caller may not take this action."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "There is no such operation, or the record the call names does not exist."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request's state does not allow this action."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The Idempotency-Key was sent with a different body in the last 24 hours."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A limit is exceeded; retry after the time Retry-After gives.",
            "headers": {
              "Retry-After": {
                "description": "The seconds to wait before retrying.",
                "required": true,
                "schema": {
                  "description": "The seconds to wait before retrying.",
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Setup is not complete, or Tiehall is shutting down.",
            "headers": {
              "Retry-After": {
                "description": "The seconds to wait before retrying.",
                "required": true,
                "schema": {
                  "description": "The seconds to wait before retrying.",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "requests:write"
            ]
          }
        ],
        "summary": "Open a request to a team of the install, from one of the teams you belong to; your only team is the default, and a member of several teams names one.",
        "x-stability-level": "alpha"
      }
    }
  }
}
