                                  "properties": {
                                    "bot": {
                                      "type": "boolean"
                                    },
                                    "id": {
                                      "format": "uuid",
                                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                                      "type": "string"
                                    },
                                    "kind": {
                                      "const": "human",
                                      "type": "string"
                                    },
                                    "login": {
                                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "login",
                                    "kind",
                                    "bot"
                                  ],
                                  "type": "object"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
