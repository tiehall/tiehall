{
  "name": "tiehall-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages actions tools",
    "check:model-sdks": "node tools/repo-checks/src/check-model-sdks.ts",
    "check:workflows": "node tools/repo-checks/src/check-workflows.ts",
    "scan:secrets": "node tools/repo-checks/src/scan-secrets.ts",
    "test:image": "pnpm --filter @tiehall/image-tests test",
    "check:compose": "node tools/repo-checks/src/check-compose.ts",
    "test:boot": "node tools/image-tests/src/boot-test.ts",
    "check:renovate": "node tools/repo-checks/src/check-renovate.ts",
    "check:licenses": "node tools/repo-checks/src/check-licenses.ts",
    "lint:migrations": "node packages/db/src/check-migrations.ts",
    "openapi:generate": "node packages/catalog/src/write-openapi.ts",
    "check:openapi": "node packages/catalog/src/check-openapi.ts",
    "mcp:generate": "node packages/catalog/src/write-tool-snapshot.ts",
    "check:mcp-tools": "node packages/catalog/src/check-tool-snapshot.ts",
    "check:confirmations": "node tools/repo-checks/src/check-confirmations.ts",
    "check:api-compat": "node tools/repo-checks/src/check-api-compat.ts",
    "changelog:release": "node tools/repo-checks/src/record-release.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
