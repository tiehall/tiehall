# Tiehall's install settings. Print a complete .env with fresh secrets instead of copying this file:
#   docker run --rm <image> init --url https://tiehall.example.com --image <image> > .env
# Keep .env secret, and back it up apart from the database.
# A secret can instead come from a file, as its NAME_FILE form, such as TIEHALL_SECRET_KEY_FILE; the path is
# inside the container, so mount the file there, for example with a compose.override.yaml.

# The install's public base URL. It must use https://, except http://localhost, with or without a
# port, for a trial on one machine.
TIEHALL_URL=https://tiehall.example.com

# The Tiehall image, pinned by version and digest as the release notes give it. To upgrade, back up,
# set the new image here and run `docker compose pull && docker compose up -d`.
TIEHALL_IMAGE=ghcr.io/<owner>/tiehall:<version>@sha256:<digest>

# The host address and port where the app's HTTP port is published. The default keeps it on this
# host, behind the caddy profile or your own reverse proxy.
TIEHALL_HTTP_BIND=127.0.0.1:3000

# The password of the database owner, which the bundled Postgres is created with. Of Tiehall's
# containers, only the migrate step receives it.
TIEHALL_DATABASE_OWNER_PASSWORD=

# The password of the app's database role, which the migrate step creates and the app connects as.
TIEHALL_DATABASE_APP_PASSWORD=

# For an external Postgres 17 or later instead of the bundled one: the connection URLs of the
# database owner and of the app role. Leave both empty to use the bundled Postgres.
TIEHALL_DATABASE_OWNER_URL=
TIEHALL_DATABASE_APP_URL=

# Encrypts the integration secrets Tiehall stores. The database and its backups do not hold it, so
# keep a copy of this file apart from them.
TIEHALL_SECRET_KEY=

# Signs sessions and tokens.
TIEHALL_AUTH_SECRET=

# The reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers are trusted: IP addresses,
# CIDR ranges or host names, separated by commas. caddy is the proxy of the caddy profile.
TIEHALL_TRUSTED_PROXIES=caddy

# on fetches the Client ID Metadata Documents of the agent clients that connect; off stops it, and
# clients register with Dynamic Client Registration instead.
TIEHALL_CLIENT_METADATA_FETCH=on

# Where the web UI links to this server's source. Leave it empty for a Tiehall release; set it when
# you run a modified server.
TIEHALL_SOURCE_URL=

# Optional email through SMTP. Without TIEHALL_SMTP_HOST, Tiehall sends no email, and notices stay
# in the web inbox and the admin banners.
#
# The SMTP server.
TIEHALL_SMTP_HOST=

# Its port: 587 for starttls, 465 for tls and 25 for none unless set.
TIEHALL_SMTP_PORT=

# starttls (the default), tls from the first byte, or none for a relay on a trusted network.
TIEHALL_SMTP_TLS=

# The user and password to log in with, both or neither.
TIEHALL_SMTP_USER=
TIEHALL_SMTP_PASSWORD=

# The address email is sent from, such as tiehall@example.com or Tiehall <tiehall@example.com>.
TIEHALL_SMTP_FROM=
