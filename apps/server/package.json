    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tiehall/commands": "workspace:*"
  },
  "devDependencies": {
    "@tiehall/core": "workspace:*",
    "@tiehall/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "rolldown": "1.2.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
